{
  "_comment": "제안 예시(P-A4-C). 현재 커밋된 .claude/settings.json 대비 변경은 PostToolUse(Edit|Write) → lint-file.mjs 추가 하나뿐이다. 점검 작업용 미커밋 hook(check-done.sh)은 넣지 않았다. JSON이라 주석을 _comment 키로 둔다 — 적용 시 지운다.",
  "permissions": {
    "allow": [
      "Bash(pnpm check)",
      "Bash(pnpm lint)",
      "Bash(pnpm typecheck)",
      "Bash(pnpm build)",
      "Bash(pnpm verify)",
      "Bash(pnpm install)",
      "Bash(pnpm dev)",
      "Bash(pnpm shot)",
      "Bash(pnpm shot *)",
      "Bash(pnpm shadcn add *)",
      "Bash(git status *)",
      "Bash(git grep *)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git branch *)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(git switch *)",
      "Bash(git clean -f -- src/components/ui/*)",
      "Bash(git push *)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.local)",
      "Read(./.env.development)",
      "Read(./.env.production)",
      "Read(./.env.*.local)",
      "Edit(./src/components/ui/**)",
      "Write(./src/components/ui/**)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/guard-bash.mjs\"",
            "timeout": 15
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/lint-file.mjs\"",
            "timeout": 60
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/stop-check.mjs\"",
            "timeout": 300
          }
        ]
      }
    ]
  }
}
